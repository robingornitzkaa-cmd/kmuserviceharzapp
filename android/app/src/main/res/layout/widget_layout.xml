<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header Row with Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_dot"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Founder OS • Power Cockpit"
            android:textColor="#06b6d4"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0d"
            android:textColor="#f97316"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sub-Header: CRM Quick Stats -->
    <TextView
        android:id="@+id/widget_crm_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="518 Leads • 0 Fällige Wiedervorlagen"
        android:textColor="#38bdf8"
        android:textSize="10sp"
        android:layout_marginBottom="4dp" />

    <!-- Google Calendar Next Meeting -->
    <TextView
        android:id="@+id/widget_meeting_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📅 Kein Termin anstehend"
        android:textColor="#2dd4bf"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="4dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#27272a"
        android:layout_marginBottom="6dp" />

    <!-- Body Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Focus Goal Section -->
        <TextView
            android:id="@+id/widget_goal_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Fokus: Bereit für den Tag"
            android:textColor="#fbbf24"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- Notizen Section -->
        <TextView
            android:id="@+id/widget_notes_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keine Notizen vorhanden."
            android:textColor="#e2e8f0"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- Aufgaben Section -->
        <TextView
            android:id="@+id/widget_todos_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keine offenen Aufgaben."
            android:textColor="#94a3b8"
            android:textSize="11sp"
            android:maxLines="5"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
