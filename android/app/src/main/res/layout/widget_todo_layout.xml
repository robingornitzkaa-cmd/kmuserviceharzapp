<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">
        
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_dot"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Founder OS • Aufgaben & Fokus"
            android:textColor="#34d399"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_todo_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 offen"
            android:textColor="#94a3b8"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#27272a"
        android:layout_marginBottom="6dp" />

    <!-- Goal / Focus Header -->
    <TextView
        android:id="@+id/widget_todo_focus_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎯 Fokus: Tagespriorität"
        android:textColor="#fbbf24"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="6dp" />

    <!-- Todos List -->
    <TextView
        android:id="@+id/widget_todo_list_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Keine offenen Aufgaben."
        android:textColor="#f1f5f9"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:maxLines="6"
        android:ellipsize="end" />
</LinearLayout>
